# Copie este arquivo para .env e preencha os valores reais

# URL do seu projeto Supabase
SUPABASE_URL=https://ovwcukyrunkhtcunyhsi.supabase.co

# ATENÇÃO: use a SERVICE ROLE KEY aqui (não a publishable/anon)
# Encontre em: Supabase → Settings → API → service_role key
SUPABASE_KEY=sua_service_role_key_aqui

# Segredo para assinar os tokens JWT (gere uma string aleatória longa)
# Sugestão: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cole_aqui_uma_string_aleatoria_de_64_chars
